# ── База данных ───────────────────────────────────────────────────────────────
POSTGRES_DB=atlas
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=change-me-strong-password

# ── Backend ───────────────────────────────────────────────────────────────────
# Длинная случайная строка, например: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-very-long-random-secret-key-in-production
# Единый пароль для входа в систему. После смены все пользователи будут разлогинены.
ADMIN_PASSWORD=change-me-strong-password
# Максимальный размер одного загружаемого файла, МБ (nginx пропускает до 210 МБ)
MAX_FILE_SIZE_MB=100
# Нужны только если фронтенд открывается с другого адреса, чем backend (режим разработки)
ALLOWED_ORIGINS=http://localhost,http://localhost:80
# true — если система работает по HTTPS
COOKIE_SECURE=false
# Число процессов backend
WEB_CONCURRENCY=2

# ── Frontend ──────────────────────────────────────────────────────────────────
# Порт веб-интерфейса на сервере
HTTP_PORT=80
# Оставьте пустым: API доступен через nginx по тому же адресу (/api).
VITE_API_URL=

# ── PgAdmin (docker compose --profile tools up -d) ───────────────────────────
PGADMIN_EMAIL=admin@atlas.local
PGADMIN_PASSWORD=change-me
